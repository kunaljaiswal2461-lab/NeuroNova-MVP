# Server
APP_ENV=dev
# Local dev only. Skips email verification when no email provider is set.
# Refused at startup unless APP_ENV=dev. Never set this in staging/prod.
# AUTH_DEV_AUTO_VERIFY=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Auth (rotate before any non-local deployment)
API_KEY=dev-local-key-change-me

# Browser destinations generated by the backend. In Render production, set
# both values to the custom frontend domain (not a Vercel deployment URL).
FRONTEND_URL=http://localhost:5173
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,https://tryneuronova.in
# Public backend origin used by emailed verification links (no /api/v1 suffix).
PUBLIC_URL=http://localhost:8000

# Email delivery. Preferred on Render Free: Resend sends over HTTPS rather
# than SMTP, which Render blocks on ports 25, 465, and 587.
# Set this to the Resend API key beginning with re_. Keep it encrypted.
RESEND_API_KEY=
# SMTP remains available as a fallback when RESEND_API_KEY is empty. For Gmail,
# use an App Password (not your regular Google password):
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_TLS=true.
# Keep SMTP_PASSWORD only in encrypted environment variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=true

# Database
DATABASE_URL=postgresql+asyncpg://neuronova:neuronova@localhost:5432/neuronova

# PostgreSQL source onboarding is off until outbound egress restrictions are
# configured. Supply real key values only through your deployment secret store.
CONNECTORS_ENABLED=false
CONNECTOR_EGRESS_POLICY_CONFIGURED=false
CONNECTOR_CREDENTIALS_ACTIVE_KEY_ID=
CONNECTOR_CREDENTIALS_ACTIVE_KEY=
CONNECTOR_CREDENTIALS_PREVIOUS_KEYRING=

# Manual PostgreSQL catalog-discovery worker. The worker is a separate
# supervised process; these values do not start it from the web application.
CATALOG_WORKER_MAX_CONCURRENT_JOBS=1
CATALOG_WORKER_POLL_INTERVAL_SECONDS=2
CATALOG_WORKER_LEASE_SECONDS=30
CATALOG_WORKER_LEASE_RENEWAL_SECONDS=5
CATALOG_WORKER_MAX_ATTEMPTS=3
CATALOG_WORKER_RETRY_BASE_SECONDS=2
CATALOG_WORKER_RETRY_MAX_SECONDS=30
CATALOG_DISCOVERY_TIMEOUT_SECONDS=45
CATALOG_DISCOVERY_MAX_TABLES=1000
CATALOG_DISCOVERY_MAX_COLUMNS=50000
CATALOG_DISCOVERY_MAX_RELATIONSHIPS=20000
CATALOG_DISCOVERY_MAX_METADATA_BYTES=4194304

# PostgreSQL structured-query planning caps. Stage 4A only validates and
# compiles plans; it does not enable client-database query execution.
POSTGRES_QUERY_MAX_RESULT_LIMIT=500
POSTGRES_QUERY_MAX_PROJECTIONS=20
POSTGRES_QUERY_MAX_FILTERS=12
POSTGRES_QUERY_MAX_AGGREGATIONS=8
POSTGRES_QUERY_MAX_GROUP_BY=4
POSTGRES_QUERY_MAX_IN_VALUES=100
POSTGRES_QUERY_MAX_PARAMETER_BYTES=65536

# Controlled PostgreSQL execution (Stage 4B). These limits apply only after
# connectors are explicitly enabled and remain per-process, not distributed.
POSTGRES_EXECUTION_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_EXECUTION_STATEMENT_TIMEOUT_SECONDS=5
POSTGRES_EXECUTION_LOCK_TIMEOUT_SECONDS=2
POSTGRES_EXECUTION_IDLE_TRANSACTION_TIMEOUT_SECONDS=10
POSTGRES_EXECUTION_OPERATION_TIMEOUT_SECONDS=12
POSTGRES_EXECUTION_MAX_CONCURRENT_OPERATIONS=2
POSTGRES_EXECUTION_MAX_CONCURRENT_PER_USER=1
POSTGRES_EXECUTION_MAX_CONCURRENT_PER_SOURCE=1
POSTGRES_EXECUTION_MAX_RESULT_ROWS=500
POSTGRES_EXECUTION_MAX_RESULT_BYTES=1048576
POSTGRES_EXECUTION_CURSOR_PREFETCH=50

# Optional bounded source profiling (Stage 6A). Profiling remains disabled on
# every new source until its owner explicitly opts in. The shared catalog worker
# must be separately supervised; these values never start it in the web process.
POSTGRES_PROFILE_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_PROFILE_STATEMENT_TIMEOUT_SECONDS=8
POSTGRES_PROFILE_LOCK_TIMEOUT_SECONDS=2
POSTGRES_PROFILE_IDLE_TRANSACTION_TIMEOUT_SECONDS=10
POSTGRES_PROFILE_OPERATION_TIMEOUT_SECONDS=15
POSTGRES_PROFILE_SAMPLE_PERCENT=1
POSTGRES_PROFILE_SAMPLE_LIMIT=5000
POSTGRES_PROFILE_MAX_TABLES_PER_RUN=10
POSTGRES_PROFILE_MAX_COLUMNS_PER_TABLE=25
POSTGRES_PROFILE_MAX_COLUMNS_PER_RUN=100
POSTGRES_PROFILE_MAX_OPERATIONS_PER_RUN=250
POSTGRES_PROFILE_MAX_CONCURRENT_OPERATIONS=1
SOURCE_PROFILE_WORKER_MAX_CONCURRENT_JOBS=1
SOURCE_PROFILE_WORKER_POLL_INTERVAL_SECONDS=2
SOURCE_PROFILE_WORKER_LEASE_SECONDS=45
SOURCE_PROFILE_WORKER_LEASE_RENEWAL_SECONDS=5
SOURCE_PROFILE_WORKER_MAX_ATTEMPTS=2
SOURCE_PROFILE_WORKER_RETRY_BASE_SECONDS=5
SOURCE_PROFILE_WORKER_RETRY_MAX_SECONDS=30

# Storage
STORAGE_BACKEND=local
DATA_DIR=./data
MAX_UPLOAD_BYTES=20971520
# 21 MiB request cap includes multipart overhead around a 20 MiB file.
MAX_REQUEST_BYTES=22020096
# Per process: deploy one Uvicorn worker for the pilot.
MAX_CONCURRENT_PIPELINES=1

# OpenAI (Layer 5+)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
