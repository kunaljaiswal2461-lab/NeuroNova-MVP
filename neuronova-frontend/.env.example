# Frontend environment variables.
# Copy to .env.local for local dev (that file is gitignored). See
# docs/keep-backend-warm.md for the full deploy requirement this backs.

# API base URL, must include the /api/v1 suffix.
#
# Vercel production and preview (REQUIRED): use the absolute Render backend
# URL, e.g.:
#   VITE_API_BASE_URL=https://<RENDER_SERVICE_NAME>.onrender.com/api/v1
# vercel.json only rewrites unmatched paths to index.html; it does not proxy
# to Render. A relative value silently hits the SPA (200 OK with index.html)
# and an unset value falls back to localhost — neither reaches the backend.
# See docs/keep-backend-warm.md section 5.
#
# Local dev: may be relative (e.g. /api/v1) only if you add a Vite dev-server
# proxy for /api/v1 -> http://localhost:8000. The tracked vite.config.js has
# no such proxy, so the zero-config local value is the absolute:
#   VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Fallback API key sent as X-API-Key when no user access token is present.
# Must match the backend's API_KEY. Placeholder only, never a real secret.
VITE_API_KEY=dev-local-key-change-me
